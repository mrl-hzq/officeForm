# MySQL Docker container credentials
MYSQL_DATABASE=officeform
MYSQL_USER=officeform
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root

# Flask app DB connection for `python app_entry.py`.
# Uncomment every line in exactly one target block.

# Option A: local MySQL service (active)
DB_HOST=172.31.176.1
DB_PORT=3306
DB_NAME=officeform
DB_USER=root
DB_PASSWORD=root

# Option B: MySQL Docker container published by docker-compose.yml
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_NAME=officeform
# DB_USER=officeform
# DB_PASSWORD=officeform_pass

# JWT signing secret — change this to a long random string
JWT_SECRET_KEY=change-this-to-a-random-secret

# Shared login/registration password - change this before exposing the app
AUTH_SHARED_PASSWORD=abcd1234
